FROM docker:27-cli AS docker-cli

FROM jenkins/jenkins:lts-jdk21

# Compose has no engine-level "scale" primitive; only the real `docker
# compose` CLI knows how to add a correctly-networked replica (see
# common.orchestration.execution_plan.docker_compose_scale_plan and this
# repo's Jenkinsfile.auto-remediation approvedComposeScaleCommand). This
# container never runs a daemon of its own -- DOCKER_HOST already points the
# CLI at the sandboxed docker-socket-proxy (see the jenkins service in
# docker-compose.yml), so only the CLI binaries are needed, copied from
# Docker's own official image rather than hand-built from a download URL.
USER root
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
RUN chmod +x /usr/local/bin/docker /usr/local/lib/docker/cli-plugins/docker-compose
USER jenkins

# Explicitly select patched library/multibranch plugins rather than accepting
# the older minimum versions pulled by workflow-aggregator dependencies.
# https://www.jenkins.io/security/advisory/2026-09-16/
RUN jenkins-plugin-cli --plugins workflow-aggregator pipeline-utility-steps pipeline-milestone-step timestamper \
    workflow-multibranch:842.v3a_b_59b_57b_e6e pipeline-groovy-lib:806.v408277b_33d1d

COPY init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/
