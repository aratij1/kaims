{
  "version": "connectors-v2",
  "last_reviewed": "2026-07-22",
  "default_connector": "kaiops-api",
  "auto_onboarding": {
    "enabled": true,
    "template_connector": "generic-api",
    "requires_reusable_playbook": true,
    "allowed_operations": [
      "read_status",
      "read_metrics",
      "script_execution",
      "restart_service",
      "scale_service",
      "verify_slo",
      "verify_service_health"
    ]
  },
  "connection_policy": {
    "live_execution_requires_secret_ref": true,
    "dry_run_default": true,
    "timeout_seconds_default": 15,
    "retry": {
      "max_attempts": 2,
      "backoff_seconds": 3
    }
  },
  "connectors": {
    "kaiops-api": {
      "connector_id": "kaiops-api",
      "system": "kaiops-platform",
      "type": "api",
      "endpoint": "http://api-gateway:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/api-gateway-token",
      "timeout_seconds": 15,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "api_execution",
        "script_execution",
        "verify_slo",
        "verify_service_health",
        "verify_onboarding_flow",
        "verify_workflow_health",
        "retry_workflow"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    },
    "api-gateway": {
      "connector_id": "api-gateway-runtime",
      "system": "api-gateway",
      "type": "api",
      "endpoint": "http://api-gateway:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/api-gateway-token",
      "timeout_seconds": 15,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "api_execution",
        "script_execution",
        "restart_service",
        "scale_service",
        "rollback_deployment",
        "verify_slo",
        "verify_service_health",
        "verify_onboarding_flow"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    },
    "kaiops-core": {
      "connector_id": "kaiops-core-runtime",
      "system": "kaiops-core",
      "type": "api",
      "endpoint": "http://kaiops-core:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/kaiops-core-token",
      "timeout_seconds": 15,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "api_execution",
        "script_execution",
        "restart_service",
        "scale_service",
        "rollback_deployment",
        "verify_slo",
        "verify_service_health",
        "verify_onboarding_flow"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    },
    "kaiops-core1": {
      "connector_id": "kaiops-core1-runtime",
      "system": "kaiops-core1",
      "type": "api",
      "endpoint": "http://kaiops-core1:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/kaiops-core1-token",
      "timeout_seconds": 15,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "api_execution",
        "script_execution",
        "restart_service",
        "scale_service",
        "rollback_deployment",
        "verify_slo",
        "verify_service_health",
        "verify_onboarding_flow"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    },
    "kaiops-platform": {
      "connector_id": "kaiops-platform-runtime",
      "system": "kaiops-platform",
      "type": "api",
      "endpoint": "http://api-gateway:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/platform-token",
      "timeout_seconds": 15,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "api_execution",
        "script_execution",
        "read_database",
        "replay_etl_batch",
        "verify_data_quality",
        "restart_service",
        "scale_service",
        "rollback_deployment",
        "verify_service_health",
        "verify_onboarding_flow",
        "verify_workflow_health",
        "retry_workflow",
        "verify_slo"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    },
    "mysql": {
      "connector_id": "kaiops-mysql",
      "system": "mysql",
      "type": "mysql",
      "host": "mysql",
      "port": 3306,
      "database": "kaiops",
      "auth_method": "database-user",
      "secret_ref": "vault://kaiops/prod/mysql-password",
      "timeout_seconds": 15,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "read_database",
        "archive_database_rows",
        "verify_database_health",
        "api_execution",
        "script_execution",
        "verify_onboarding_flow"
      ],
      "health_check": {
        "command": "SELECT 1"
      }
    },
    "etl-orders": {
      "connector_id": "etl-orders-runtime",
      "system": "etl-orders",
      "type": "api",
      "endpoint": "http://api-gateway:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/etl-orders-token",
      "timeout_seconds": 20,
      "allowed_operations": [
        "read_status",
        "read_database",
        "replay_etl_batch",
        "verify_data_quality",
        "api_execution",
        "script_execution"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    },
    "policy-engine": {
      "connector_id": "policy-engine-runtime",
      "system": "policy-engine",
      "type": "api",
      "endpoint": "http://policy-engine:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/policy-engine-token",
      "timeout_seconds": 15,
      "allowed_operations": [
        "read_status",
        "restart_service",
        "verify_service_health",
        "api_execution",
        "script_execution"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    },
    "prometheus": {
      "connector_id": "prometheus-http",
      "system": "prometheus",
      "type": "http",
      "endpoint": "http://prometheus:9090",
      "auth_method": "none",
      "secret_ref": "",
      "timeout_seconds": 10,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "verify_slo",
        "verify_onboarding_flow"
      ],
      "health_check": {
        "method": "GET",
        "path": "/-/healthy"
      }
    },
    "rabbitmq": {
      "connector_id": "rabbitmq-management",
      "system": "rabbitmq",
      "type": "api",
      "endpoint": "http://rabbitmq:15672",
      "auth_method": "basic",
      "secret_ref": "vault://kaiops/prod/rabbitmq-management",
      "timeout_seconds": 10,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "verify_service_health"
      ],
      "health_check": {
        "method": "GET",
        "path": "/api/health/checks/alarms"
      }
    },
    "generic-api": {
      "connector_id": "generic-api",
      "system": "generic",
      "type": "api",
      "endpoint": "http://api-gateway:8000",
      "auth_method": "service-account-token",
      "secret_ref": "vault://kaiops/prod/default-token",
      "timeout_seconds": 10,
      "allowed_operations": [
        "read_status",
        "read_metrics",
        "api_execution",
        "script_execution",
        "restart_service",
        "scale_service",
        "rollback_deployment",
        "verify_slo",
        "verify_service_health",
        "verify_onboarding_flow"
      ],
      "health_check": {
        "method": "GET",
        "path": "/healthz"
      }
    }
  }
}
