    {
      "id": "kaiops-service-down-playbook",
      "governance_id": "5747665d-13ac-46b0-9d21-f45907f75a96",
      "version": 1,
      "status": "approved",
      "owner": "kaiops-platform-sre",
      "approver": "release-owner",
      "approved_at": "2026-08-21T00:00:00Z",
      "approval_expires_at": "2027-08-21T00:00:00Z",
      "checksum_sha256": "sha256:a44d34783f26059077d4496073e48ad93ee45fa2f99aa2d148aea03caf6e89b1",
      "risk_class": "high",
      "name": "KaiOps service down recovery",
      "match": {
        "allow_unlisted_services": true,
        "alert_ids": [],
        "services": [
          "kaiops-core1",
          "kaiops-core",
          "api-gateway",
          "kaiops-platform"
        ],
        "alert_types": [
          "availability",
          "service_down",
          "service"
        ],
        "alert_keywords": [
          "servicedown",
          "service down",
          "unreachable",
          "not reachable",
          "endpoint down",
          "availability"
        ]
      },
      "risk_tier": "high",
      "preflight_checks": [
        "Connector health check passes or fallback diagnostic captures failure",
        "Prometheus still reports the service as unavailable",
        "Human approval is present before restart, scale, or rollback"
      ],
      "steps": [
        {
          "name": "Collect service availability diagnostics",
          "type": "diagnostic",
          "commands": [
            "check_api_gateway_health",
            "check_prometheus_alerts",
            "check_prometheus_targets",
            "query_service_availability"
          ]
        },
        {
          "name": "Run guarded KaiOps triage script",
          "type": "diagnostic",
          "commands": [
            "check_kaiops_triage_script_dry_run"
          ]
        },
        {
          "name": "Restart affected runtime service if approved",
          "type": "remediation",
          "approval_gate": true,
          "commands": [
            "restart_service_runtime"
          ]
        },
        {
          "name": "Validate service recovery",
          "type": "validation",
          "commands": [
            "validate_service_recovery",
            "check_prometheus_alerts"
          ]
        }
      ]
    },
