# Generated UI and runtime artifacts
.tmp-ui-bundle.js
backend/ingested_alerts/input/*.json
backend/ingested_alerts/input/*.csv
backend/ingested_alerts/input/*.eml
# processed/ and failed/ are date-partitioned (YYYY/MM/DD); tracked *.txt
# sample fixtures stay tracked, only generated *.json audit records are ignored.
backend/ingested_alerts/processed/**/*.json
backend/ingested_alerts/failed/**/*.json
# input_replayed/ and input_failed/ hold nothing but generated archive copies.
backend/ingested_alerts/input_replayed/**
backend/ingested_alerts/input_failed/**

# Fault-lab generated runtime logs
fault-lab/runtime/*.log

# Generated onboarding outputs
backend/rag/changes/**
backend/rag/dependencies/*.md
backend/rag/incidents/*-rule-onboarding.md
backend/rag/runbooks/*-rule-runbook.md
# Runtime review packets are evidence awaiting governance, never source fixtures.
backend/rag/_review/**/*.json

# Local recovery watcher process output
docs/architecture/*.stdout.log
docs/architecture/*.stderr.log

# Local database retention archives contain operational evidence.
backend/retention-archives/
backend/host-evidence/
config/disk-attribution.local.json
# Local caches and downloaded third-party checkouts
/pytest-cache-files-*/
/external/
*.pem
*.pfx
*.p12

# Machine-specific integration settings and runtime state
replacement/telemetry-sources.local.json
backend/ingested_alerts/jira_admission_state.json
